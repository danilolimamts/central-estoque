{
  "name": "equalizacao-elevadores",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Central de Equalizacao de Elevadores - CD Cajamar, Loja do Mecanico",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "demo:planilha": "node scripts/gerarPlanilhaDemo.mjs demo.xlsx",
    "publicar": "npm run build && node scripts/publicarNoSite.mjs",
    "verificar:pptx": "npm run build && node scripts/verificarPptx.mjs dist/index.html demo.xlsx .",
    "verificar:navegador": "npm run build && node scripts/verificarNavegador.mjs demo.xlsx ."
  },
  "dependencies": {
    "chart.js": "^4.4.7",
    "chartjs-plugin-datalabels": "^2.2.0",
    "localforage": "^1.10.0",
    "pptxgenjs": "^3.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.61.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
